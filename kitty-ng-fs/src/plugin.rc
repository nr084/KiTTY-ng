#pragma code_page(65001)
#include <windows.h>
#include "resource.h"
#include "metadata.h"

// TC uses the first icon by resource index for Network Neighborhood.
IDI_PLUGIN ICON "../assets/plugin.ico"
IDI_SSH ICON "../assets/ssh.ico"
IDI_SETTINGS ICON "../assets/settings.ico"

IDD_SETTINGS DIALOGEX 0, 0, 348, 220
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "KiTTY-ng FS 1.0.3 — настройки"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Папка портативной KiTTY-ng:", -1, 10, 10, 315, 12
    EDITTEXT IDC_ROOT, 10, 25, 271, 16, ES_AUTOHSCROLL
    PUSHBUTTON "Обзор…", IDC_BROWSE, 287, 25, 51, 16
    LTEXT "Относительный путь считается от папки плагина. Можно использовать %COMMANDER_PATH%.", -1, 10, 45, 326, 24
    LTEXT "Начальный каталог сервера:", -1, 10, 75, 178, 12
    EDITTEXT IDC_REMOTE_ROOT, 196, 72, 142, 16, ES_AUTOHSCROLL
    LTEXT "«/» — корень сервера; «.» — домашний каталог SSH-пользователя.", -1, 10, 93, 325, 22
    LTEXT "Тайм-аут без ответа, секунд:", -1, 10, 119, 180, 12
    EDITTEXT IDC_TIMEOUT, 196, 116, 54, 16, ES_NUMBER
    LTEXT KG_AUTHOR_LABEL, IDC_AUTHOR, 10, 143, 326, 12
    PUSHBUTTON KG_HOMEPAGE_LABEL, IDC_HOMEPAGE, 10, 159, 328, 18
    DEFPUSHBUTTON "Сохранить", IDOK, 214, 190, 62, 18
    PUSHBUTTON "Отмена", IDCANCEL, 282, 190, 56, 18
END

1 VERSIONINFO
FILEVERSION 1,0,3,0
PRODUCTVERSION 1,0,3,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "KiTTY-ng filesystem plugin for Total Commander"
   VALUE "CompanyName", KG_AUTHOR
   VALUE "Author", KG_AUTHOR
   VALUE "Comments", KG_FILE_COMMENTS
   VALUE "FileVersion", "1.0.3"
   VALUE "ProductName", "KiTTY-ng FS"
   VALUE "ProductVersion", "1.0.3"
   VALUE "LegalCopyright", KG_COPYRIGHT
   VALUE "URLInfoAbout", KG_HOMEPAGE_URL
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
