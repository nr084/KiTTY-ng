/*
 * Windows resources shared between PuTTY and PuTTYtel, to be #include'd
 * after defining appropriate macros.
 *
 * Note that many of these strings mention PuTTY. Due to restrictions in
 * VC's handling of string concatenation, this can't easily be fixed.
 * It's fixed up at runtime.
 *
 * This file has the more or less arbitrary extension '.rc2' to avoid
 * IDEs taking it to be a top-level resource script in its own right
 * (which has been known to happen if the extension was '.rc'), and
 * also to avoid the resource compiler ignoring everything included
 * from it (which happens if the extension is '.h').
 */

/* Accelerators used: clw */
IDD_ABOUTBOX DIALOG DISCARDABLE 140, 40, 350, 230
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About PuTTY"
FONT 9, "Segoe UI"
BEGIN
    ICON IDI_MAINICON, IDA_ICON, 12, 10, 32, 32
    LTEXT "", IDA_BRAND, 54, 10, 284, 18
    LTEXT "", IDA_VERSION, 54, 30, 284, 12
    EDITTEXT IDA_TEXT, 12, 54, 326, 150, ES_READONLY | ES_MULTILINE | ES_LEFT, WS_EX_STATICEDGE
    PUSHBUTTON "View &Licence", IDA_LICENCE, 12, 210, 78, 14
    PUSHBUTTON "Visit &Web Site", IDA_WEB, 182, 210, 88, 14
    DEFPUSHBUTTON "&Close", IDOK, 280, 210, 58, 14
END

/* Accelerators used: aco */
IDD_MAINBOX DIALOG DISCARDABLE 0, 0, 400, 330
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PuTTY Configuration"
FONT 8, "MS Shell Dlg"
CLASS "PuTTYConfigBox"
BEGIN
END

/* Accelerators used: co */
IDD_LOGBOX DIALOGEX 100, 20, 420, 220
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX
CAPTION "PuTTY Event Log"
FONT 9, "Segoe UI"
BEGIN
    DEFPUSHBUTTON "&Close", IDOK, 214, 194, 62, 18
    PUSHBUTTON "C&opy", IDN_COPY, 144, 194, 62, 18
    LISTBOX IDN_LIST, 8, 8, 404, 178, LBS_HASSTRINGS | LBS_USETABSTOPS | WS_VSCROLL | WS_HSCROLL | LBS_EXTENDEDSEL | WS_TABSTOP
END

/* No accelerators used */
IDD_LICENCEBOX DIALOG DISCARDABLE 50, 50, 326, 239
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PuTTY Licence"
FONT 8, "MS Shell Dlg"
BEGIN
    DEFPUSHBUTTON "OK", IDOK, 148, 219, 44, 14

    EDITTEXT IDA_TEXT, 10, 10, 306, 200, ES_READONLY | ES_MULTILINE | ES_LEFT, WS_EX_STATICEDGE
END

/* Accelerators used: achio */
IDD_HOSTKEY DIALOG DISCARDABLE 50, 50, 460, 240
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PuTTY Security Alert"
FONT 8, "MS Shell Dlg"
CLASS "PuTTYHostKeyDialog"
BEGIN
    ICON "", IDC_HK_ICON, 10, 18, 0, 0

    PUSHBUTTON "&Cancel", IDCANCEL, 390, 220, 58, 14
    PUSHBUTTON "&Accept", IDC_HK_ACCEPT, 216, 220, 58, 14
    PUSHBUTTON "Connect &Once", IDC_HK_ONCE, 282, 220, 100, 14
    PUSHBUTTON "More &info...", IDC_HK_MOREINFO, 78, 220, 116, 14
    PUSHBUTTON "&Help", IDHELP, 12, 220, 58, 14

    LTEXT "", IDC_HK_TITLE, 40, 20, 410, 12

    EDITTEXT IDC_HK_TEXT, 40, 20, 410, 200, ES_READONLY | ES_MULTILINE | ES_LEFT, WS_EX_STATICEDGE
END

/* Accelerators used: c */
IDD_HK_MOREINFO DIALOG DISCARDABLE 140, 40, 400, 300
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PuTTY: information about the server's host key"
FONT 8, "MS Shell Dlg"
CLASS "PuTTYHostKeyMoreInfo"
BEGIN
    DEFPUSHBUTTON "&Close", IDOK, 176, 130, 48, 14
END

/* Accelerators used: aco */
IDD_CA_CONFIG DIALOG DISCARDABLE 0, 0, 350, 260
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PuTTY trusted host certification authorities"
FONT 8, "MS Shell Dlg"
CLASS "PuTTYConfigBox"
BEGIN
END

#include "version.rc2"
